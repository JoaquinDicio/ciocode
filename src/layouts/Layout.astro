---
import { siteConfig, whatsappUrl } from '../config/site';
import { content } from '../i18n';
import '../styles/global.css';
import 'aos/dist/aos.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${content.site.name} — ${content.site.tagline}`,
  description = content.site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const ogImage = new URL('/og-image.png', siteConfig.siteUrl).toString();
const wa = whatsappUrl(content.whatsapp.prototypeMessage);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: content.site.name,
  url: siteConfig.siteUrl,
  description: content.site.description,
  areaServed: 'AR',
  sameAs: [siteConfig.contact.instagramUrl].filter(Boolean),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050b18" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={content.site.locale} />
    <meta property="og:site_name" content={content.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-night-950 text-slate-100 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-night-950/85 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Principal">
        <a href="#inicio" class="flex items-center gap-2.5">
          <img src="/logos/logo-c-terminal.svg" alt="CIOCODE" width="32" height="32" class="h-8 w-8" />
          <span class="text-base font-semibold tracking-tight">{content.site.name}</span>
        </a>
        <ul class="hidden items-center gap-7 text-sm text-slate-300 md:flex">
          {content.nav.links.map((link) => (
            <li>
              <a class="link-hover hover:text-white" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          data-track="whatsapp-header"
          class="btn-primary btn-gradient rounded-lg px-4 py-2 text-sm font-semibold text-white"
        >
          {content.nav.cta}
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p class="flex items-center gap-2.5"><img src="/logos/logo-c-terminal.svg" alt="CIOCODE" width="24" height="24" class="h-6 w-6" /><span><span class="font-semibold text-slate-200">{content.site.name}</span> — {content.footer.tagline}</span></p>
        <div class="flex items-center gap-5">
          <a class="link-hover hover:text-white" href={wa} target="_blank" rel="noopener">{content.footer.whatsappLabel}</a>
          {siteConfig.contact.email ? (
            <a class="link-hover hover:text-white" href={`mailto:${siteConfig.contact.email}`}>{content.footer.emailLabel}</a>
          ) : null}
          {siteConfig.contact.instagramUrl ? (
            <a
              class="link-hover hover:text-white"
              href={siteConfig.contact.instagramUrl}
              target="_blank"
              rel="noopener"
              aria-label={content.footer.instagramLabel}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" /></svg>
            </a>
          ) : null}
        </div>
      </div>
    </footer>

    <a
      href={wa}
      target="_blank"
      rel="noopener"
      data-track="whatsapp-float"
      aria-label="Hablar por WhatsApp"
      class="btn-primary btn-gradient fixed right-5 bottom-20 z-50 flex h-12 w-12 items-center justify-center rounded-full text-white shadow-lg md:bottom-6"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.1 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 9.88 9.89c0 5.45-4.44 9.88-9.89 9.88m8.42-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.4"/></svg>
    </a>

    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-night-950/90 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden">
      <a
        href={wa}
        target="_blank"
        rel="noopener"
        data-track="whatsapp-sticky-mobile"
        class="btn-primary btn-gradient flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold text-white"
      >
        {content.nav.cta} — sin costo
      </a>
    </div>

    <script>
      import AOS from 'aos';
      AOS.init({
        once: true,
        duration: 700,
        offset: 60,
        easing: 'ease-out-cubic',
        disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      });
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest('[data-track]') as HTMLElement | null;
        if (!el) return;
        const name = el.getAttribute('data-track') || 'click';
        // @ts-ignore dataLayer opcional (GTM/GA4)
        (window as any).dataLayer = (window as any).dataLayer || [];
        // @ts-ignore
        (window as any).dataLayer.push({ event: 'click_whatsapp', cta: name });
      });
    </script>
  </body>
</html>
