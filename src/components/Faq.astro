---
import SectionHeading from './SectionHeading.astro';
import { content } from '../i18n';

const copy = content.faq;
---

<section id="faq" class="scroll-mt-20 border-b border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {copy.items.map((item) => (
        <details class="card-subtle group rounded-2xl p-7" data-aos="fade-up">
          <summary class="cursor-pointer list-none text-base font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {item.q}
              <span class="text-brand-300 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
