---
import { Globe, Layers, Zap, Cloud, Cpu, MessageCircle } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import { content } from '../i18n';
import { whatsappUrl } from '../config/site';
import { services } from '../data/services';

const copy = content.services;
const icons = { globe: Globe, layers: Layers, zap: Zap, cloud: Cloud, cpu: Cpu } as const;
const featured = services.find((s) => s.featured);
const rest = services.filter((s) => !s.featured);
const ctaLabel = 'ctaLabel' in copy ? (copy.ctaLabel as string) : 'Quiero esto';
function serviceCta(title: string) {
  return whatsappUrl(`${content.whatsapp.servicePrefix} ${title} para mi negocio. ¿Me pasan propuesta y prototipo?`);
}
---

<section id="servicios" class="scroll-mt-20 border-b border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featured ? (
        <article class="featured-gradient rounded-2xl border border-brand-400/30 p-7 md:col-span-2 lg:row-span-1" data-aos="fade-up">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500 text-white">
            {(() => { const Icon = icons[featured.icon]; return <Icon size={22} aria-hidden="true" />; })()}
          </div>
          <p class="mt-5 text-xs font-semibold tracking-wide text-brand-300 uppercase">{copy.featuredLabel}</p>
          <h3 class="mt-2 text-2xl font-semibold text-white">{featured.title}</h3>
          <p class="mt-3 max-w-xl leading-relaxed text-slate-400">{featured.description}</p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            <a href="#web" class="link-hover text-sm font-semibold text-brand-300 hover:text-white">
              {copy.featuredLink}
            </a>
            <a href={serviceCta(featured.title)} target="_blank" rel="noopener" data-track={`whatsapp-servicio-${featured.slug}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:text-brand-300">
              <MessageCircle size={15} aria-hidden="true" />
              {ctaLabel}
            </a>
          </div>
        </article>
      ) : null}

      {rest.map((service, i) => (
        <article class="card-subtle flex flex-col rounded-2xl p-7" data-aos="fade-up" data-aos-delay={String((i % 3) * 100)}>
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-night-900 text-brand-300">
            {(() => { const Icon = icons[service.icon]; return <Icon size={22} aria-hidden="true" />; })()}
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">{service.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{service.description}</p>
          <a href={serviceCta(service.title)} target="_blank" rel="noopener" data-track={`whatsapp-servicio-${service.slug}`} class="link-hover mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-300 hover:text-white">
            <MessageCircle size={15} aria-hidden="true" />
            {ctaLabel} · {service.title}
          </a>
        </article>
      ))}
    </div>

    <p class="mt-8 text-sm text-slate-500">{copy.note}</p>
  </div>
</section>
