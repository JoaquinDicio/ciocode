---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl" data-aos="fade-up">
  <p class="text-sm font-semibold tracking-wide text-brand-300 uppercase">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
  {description ? <p class="mt-4 text-base leading-relaxed text-slate-400">{description}</p> : null}
</div>
