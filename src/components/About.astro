---
import SectionHeading from './SectionHeading.astro';
import { content } from '../i18n';

const copy = content.about;
---

<section id="sobre-ciocode" class="scroll-mt-20 border-b border-white/5 bg-night-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-start">
      <SectionHeading
        eyebrow={copy.eyebrow}
        title={copy.title}
      />
      <div class="space-y-5 leading-relaxed text-slate-400" data-aos="fade-up" data-aos-delay="100">
        {copy.paragraphs.map((paragraph, i) => (
          <p class={i === copy.paragraphs.length - 1 ? 'text-slate-300' : undefined}>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>
