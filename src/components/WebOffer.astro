---
import { Check, MessageCircle } from '@lucide/astro';
import { whatsappUrl } from '../config/site';
import { content } from '../i18n';

const copy = content.webOffer;
const cta = whatsappUrl(content.whatsapp.webMessage);
---

<section id="web" class="scroll-mt-20 border-b border-white/5 bg-night-900/40">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div data-aos="fade-up">
        <p class="text-sm font-semibold tracking-wide text-brand-300 uppercase">{copy.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {copy.title}
        </h2>
        <p class="mt-4 leading-relaxed text-slate-400">
          {copy.description}
        </p>
        <p class="mt-6 flex flex-wrap items-baseline gap-3">
          <span class="text-xl font-semibold text-slate-500 line-through">{copy.priceOld}</span>
          <span class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{copy.priceNew}</span>
        </p>
        <p class="mt-2 text-sm font-semibold text-brand-300">{copy.priceNote}</p>
        <a
          href={cta}
          target="_blank"
          rel="noopener"
          data-track="whatsapp-weboffer"
          class="btn-primary btn-gradient mt-8 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-base font-semibold text-white"
        >
          <MessageCircle size={18} aria-hidden="true" />
          {copy.cta}
        </a>
        <p class="mt-3 text-xs text-slate-500">{copy.trust}</p>
      </div>

      <div class="card-subtle rounded-2xl p-7 sm:p-8" data-aos="fade-up" data-aos-delay="150">
        <h3 class="text-base font-semibold text-white">{copy.listTitle}</h3>
        <ul class="mt-5 space-y-3.5">
          {copy.included.map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-brand-300">
                <Check size={14} aria-hidden="true" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ol class="mt-10 grid gap-5 border-t border-white/10 pt-6 sm:grid-cols-3" data-aos="fade-up">
      {copy.steps.map((s) => (
        <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-night-950/60 px-4 py-3.5">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-500/20 text-sm font-bold text-brand-300">
            {s.n}
          </span>
          <span>
            <span class="block text-sm font-semibold text-white">{s.t}</span>
            <span class="block text-xs text-slate-400">{s.d}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
