---
import { MessageCircle } from '@lucide/astro';
import { whatsappUrl, siteConfig } from '../config/site';
import { content } from '../i18n';

const copy = content.finalCta;
const direct = whatsappUrl(content.whatsapp.finalMessage);
const form = 'form' in copy ? copy.form : null;
---

<section id="contacto" class="hero-glow scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <div class="panel-gradient grid gap-10 rounded-2xl border border-brand-400/25 px-5 py-10 sm:px-10 md:grid-cols-2 md:items-start md:py-14" data-aos="fade-up">
      <div class="text-left">
        <h2 class="max-w-xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {copy.titleBefore}<span class="text-gradient">{copy.titleAccent}</span>{copy.titleAfter}
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-slate-400">
          {copy.description}
        </p>
        <a
          href={direct}
          target="_blank"
          rel="noopener"
          data-track="whatsapp-final-directo"
          class="link-hover mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-300 hover:text-white"
        >
          <MessageCircle size={16} aria-hidden="true" />
          {'directCta' in copy ? (copy.directCta as string) : 'O escribinos directo'}
        </a>
      </div>

      <form id="contact-form" class="card-subtle rounded-2xl p-5 sm:p-8" data-wa-number={siteConfig.contact.whatsappNumber}>
        <label class="block text-sm font-medium text-slate-200" for="cf-name">
          {form?.nameLabel ?? 'Tu nombre'}
        </label>
        <input
          id="cf-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder={form?.namePlaceholder ?? ''}
          class="mt-2 w-full rounded-lg border border-white/10 bg-night-950 px-3.5 py-2.5 text-base text-white placeholder:text-slate-500 focus:border-brand-400 focus:outline-none sm:text-sm"
        />
        <label class="mt-5 block text-sm font-medium text-slate-200" for="cf-type">
          {form?.typeLabel ?? '¿Qué necesitás?'}
        </label>
        <select
          id="cf-type"
          name="type"
          class="mt-2 w-full rounded-lg border border-white/10 bg-night-950 px-3.5 py-2.5 text-base text-white focus:border-brand-400 focus:outline-none sm:text-sm"
        >
          {(form?.typeOptions ?? []).map((opt) => <option>{opt}</option>)}
        </select>
        <label class="mt-5 block text-sm font-medium text-slate-200" for="cf-msg">
          {form?.messageLabel ?? 'Mensaje'}
        </label>
        <textarea
          id="cf-msg"
          name="message"
          rows="3"
          placeholder={form?.messagePlaceholder ?? ''}
          class="mt-2 w-full resize-none rounded-lg border border-white/10 bg-night-950 px-3.5 py-2.5 text-base text-white placeholder:text-slate-500 focus:border-brand-400 focus:outline-none sm:text-sm"
        ></textarea>
        <button
          type="submit"
          data-track="whatsapp-final-form"
          class="btn-primary btn-gradient mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg px-6 py-3 text-base font-semibold text-white"
        >
          <MessageCircle size={18} aria-hidden="true" />
          {copy.cta}
        </button>
        <p class="mt-3 text-center text-xs text-slate-500">{form?.note ?? ''}</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const type = String(data.get('type') || '').trim();
    const msg = String(data.get('message') || '').trim();
    const text = `Hola CIOCODE, soy ${name || '...'}. Necesito: ${type || '...'}. Detalle: ${msg || '...'}`;
    const number = form.dataset.waNumber || '';
    const url = number
      ? `https://wa.me/${number}?text=${encodeURIComponent(text)}`
      : `https://wa.me/?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
