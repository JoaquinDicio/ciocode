---
import SectionHeading from "./SectionHeading.astro";
import { content } from "../i18n";
import { steps } from "../data/process";

const copy = content.process;
---

<section id="proceso" class="scroll-mt-20 border-b border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li
            class="card-subtle rounded-2xl p-7"
            data-aos="fade-up"
            data-aos-delay={String((i % 4) * 100)}
          >
            <p class="font-semibold text-brand-300">{step.number}</p>
            <h3 class="mt-2 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
